[default]
build: mermaid
  mkdir -p out
  xelatex -interaction=nonstopmode -output-directory=out main.tex
  xelatex -interaction=nonstopmode -output-directory=out main.tex
  xelatex -interaction=nonstopmode -output-directory=out main.tex

mermaid:
  mkdir -p out/diagrams
  mmdc -t neutral -b transparent -i diagrams/high_level_architecture.mmd -o out/diagrams/high_level_architecture.png
  mmdc -t neutral -b transparent -i diagrams/runtime_session_flow.mmd -o out/diagrams/runtime_session_flow.png
  mmdc -t neutral -b transparent -i diagrams/gpu_tick_flow.mmd -o out/diagrams/gpu_tick_flow.png
  mmdc -t neutral -b transparent -i diagrams/export_analysis_flow.mmd -o out/diagrams/export_analysis_flow.png

clean:
  rm -rf out
