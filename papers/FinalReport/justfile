[default]
build: mermaid
  mkdir -p out
  xelatex -interaction=nonstopmode -output-directory=out main.tex
  xelatex -interaction=nonstopmode -output-directory=out main.tex
  xelatex -interaction=nonstopmode -output-directory=out main.tex

mermaid:
  mkdir -p out/diagrams
  mmdc -t neutral -e pdf -f -w 2400 -H 1400 -i diagrams/high_level_architecture.mmd -o out/diagrams/high_level_architecture.pdf
  mmdc -t neutral -e pdf -f -w 2600 -H 1400 -i diagrams/runtime_session_flow.mmd -o out/diagrams/runtime_session_flow.pdf
  mmdc -t neutral -e pdf -f -w 2600 -H 1400 -i diagrams/gpu_tick_flow.mmd -o out/diagrams/gpu_tick_flow.pdf
  mmdc -t neutral -e pdf -f -w 2600 -H 1400 -i diagrams/export_analysis_flow.mmd -o out/diagrams/export_analysis_flow.pdf

clean:
  rm -rf out
